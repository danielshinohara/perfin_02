# Copie para .env e preencha com os valores reais. Nunca versione o .env.
GITHUB_REPO_URL=https://github.com/danielshinohara/perfin_02
GITHUB_CURSOS_URL=https://github.com/caioross/cursos-certificados-free

# ---------------------------------------------------------------
# Aplicativo (Portal Perfin) — cadastrar também na Vercel (Production)
# ---------------------------------------------------------------
# URL pública do portal na Vercel (ex.: https://<app>.vercel.app). Nunca localhost.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
# Chave publicável do Supabase (sb_publishable_...). É pública por definição.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# E-mail do administrador (login com e-mail e senha). A senha fica só no Supabase Auth.
ADMIN_USUARIO=
GEMINI_API_KEY=
# 32 bytes aleatórios em base64 (criptografa os tokens do Google). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------
# Website — cadastrar na Vercel (projeto do site)
# ---------------------------------------------------------------
# No projeto do site, NEXT_PUBLIC_SITE_URL é a URL do próprio site.
PORTAL_URL=

# ---------------------------------------------------------------
# Somente local / secrets do GitHub (NÃO vão para a Vercel)
# ---------------------------------------------------------------
# Usadas pelo script Aplicativo/scripts/indicadores/indicadores_brasil.py
SUPABASE_URL=
# Chave secreta do Supabase (sb_secret_...). Ignora o RLS: nunca use no navegador.
SUPABASE_SECRET_KEY=
# Só para aplicar migrações pela linha de comando (o app não usa).
DATABASE_URL=postgresql://postgres:<SENHA_URL_ENCODED>@db.<PROJETO>.supabase.co:5432/postgres
